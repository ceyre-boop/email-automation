# TABOOST Talent Inbox Automation — required environment variables
#
# This file documents every variable the app needs. It contains NO real
# values — copy it to `.env` for local dev and fill in real ones there
# (`.env` is gitignored, never commit it). In production, these are set
# directly on the Render service (manager-email-automation,
# srv-d7lb7oe47okc738vjkg0) as environment variables — see CLAUDE.md
# "Where secrets actually live" for the full policy on how those are
# managed and backed up.
#
# Do NOT put real secret values in this file. It exists to be committed.

# ── Database ──────────────────────────────────────────────────────────────
# Supabase Postgres connection string (pooled connection, port 5432).
# Get from: Supabase dashboard → your project → Settings → Database →
# Connection string (URI format).
DATABASE_URL=postgresql://user:password@host:5432/postgres

# ── OpenAI ────────────────────────────────────────────────────────────────
# Used for email triage (gpt-4o-mini) and reply drafting (gpt-4o).
# Get from: platform.openai.com → API keys.
# NEVER migrate triage.py/reply.py to a different AI provider — see CLAUDE.md.
OPENAI_API_KEY=sk-proj-...

# ── Google OAuth (Gmail access for every talent inbox) ───────────────────
# Get from: console.cloud.google.com → APIs & Services → Credentials →
# the OAuth 2.0 Client used by this app.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
# Must exactly match an "Authorized redirect URI" registered on that same
# OAuth client in Google Cloud Console. Production value:
# https://manager-email-automation.onrender.com/auth/callback
GOOGLE_REDIRECT_URI=https://your-app-domain.onrender.com/auth/callback

# ── Google Sheets logging ─────────────────────────────────────────────────
# Refresh token for the Google account used to write the Master Activity Log
# sheet. Google does not display refresh tokens after issuance — if lost,
# it must be regenerated by re-running whatever OAuth consent flow
# originally created it.
GOOGLE_SHEETS_REFRESH_TOKEN=1//...

# ── App-internal ──────────────────────────────────────────────────────────
# Value sent in the x-api-key header to authenticate every /api/* and
# /cron/* request. Treat as the master key to the whole dashboard — see
# CLAUDE.md incident log for what happens when this leaks or gets wiped.
API_KEY=

# Purpose not fully documented as of 2026-08-03 — ask Colin before rotating.
AGENCY_SECRET_KEY=

# Base URL of this deployed service (no trailing slash). Used to build the
# Render cron heartbeat URL and other self-referential links.
APP_BASE_URL=https://your-app-domain.onrender.com

# CORS allowed origins. "*" in production (dashboard has its own API-key
# gate, this is not the security boundary).
ALLOWED_ORIGINS=*

# ── Production-only safety switch ─────────────────────────────────────────
# Render sets this to "true" deliberately — see CLAUDE.md "DB migrations"
# section before ever changing it. Leave unset for local dev (you want
# create_tables() to run against your local/dev DB).
# SKIP_MIGRATIONS=true

# ── Currently unused ────────────────────────────────────────────────────
# Not referenced anywhere in the codebase as of 2026-08-03. Safe to leave
# unset; do not spend time chasing this one down.
N8N_WEBHOOK_SECRET=
